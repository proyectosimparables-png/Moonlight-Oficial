generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id // viene de Supabase Auth
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(CLIENTE)
  image     String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  comentarios Comentario[]
  ordenes     Orden[]
  favoritos   Favorito[]
  historial   Historial[]
  cart        Cart? // relación 1:1 con carrito
}

model Producto {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Float
  stock       Int
  imagenUrl   String?
  createdAt   DateTime @default(now())
  published   Boolean  @default(false)
  imagenes    Imagen[]   // 👈 Relación con las imágenes

  // Relaciones
  favoritos   Favorito[]
  cartItems   CartItem[]

  // Relación con categoría (puede quedar null si se borra la categoría)
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  categoriaId String?

  // Relación con sección (también opcional)
  seccion   Seccion? @relation(fields: [seccionId], references: [id], onDelete: SetNull)
  seccionId String?
}


model Imagen {
  id          String   @id @default(uuid())  // 👈 ID único interno
  url         String   // 👈 tu URL de Cloudinary (sigue igual)
  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}



model Categoria {
  id        String     @id @default(uuid())
  nombre    String
  productos Producto[]

  // Jerarquía de categorías
  padre         Categoria?  @relation("CategoriaPadre", fields: [padreId], references: [id])
  padreId       String?
  subcategorias Categoria[] @relation("CategoriaPadre")

  // Relación con sección
  seccion   Seccion? @relation(fields: [seccionId], references: [id], onDelete: SetNull)
  seccionId String?
}



model Seccion {
  id         String       @id @default(uuid())
  nombre     String
  slug       String?      @unique   // 👈 OPCIONAL por ahora
  productos  Producto[]
  categorias Categoria[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime?    @updatedAt // 👈 también opcional temporalmente
}


model Comentario {
  id        String   @id @default(uuid())
  contenido String
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])
}





model Orden {
  id             String      @id @default(uuid())
  userId         String
  estado         String      // Ej: "pendiente", "enviado", "entregado"
  total          Float       // total de la orden
  correoEnviado  Boolean     @default(false) // <-- nuevo campo para tracking de mail
  createdAt      DateTime    @default(now())

  user           User        @relation(fields: [userId], references: [id])
  items          OrdenItem[] // detalles de cada producto

  @@index([userId])
}

model OrdenItem {
  id          String   @id @default(uuid())
  ordenId     String
  nombre      String
  precio      Float
  cantidad    Int
  productoId  String?    // opcional, solo para referencia si quieres saber cuál producto era
  imagenUrl   String?

  orden       Orden     @relation(fields: [ordenId], references: [id])
}




model Historial {
  id         String   @id @default(uuid())
  userId     String
  accion     String   // "visto", "comprado", etc.
  fecha      DateTime @default(now())
  
  // Snapshot opcional del producto
  productoId String?  
  nombre     String?
  precio     Float?
  imagenUrl  String?

  user       User     @relation(fields: [userId], references: [id])
}




model Favorito {
  id         String   @id @default(uuid())
  userId     String
  productoId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([userId, productoId]) // evita duplicados en favoritos
}

enum Role {
  ADMIN
  CLIENTE
}



model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id          String   @id @default(uuid())
  cartId      String
  productoId  String
  quantity    Int      @default(1)

  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  producto    Producto @relation(fields: [productoId], references: [id])

  @@unique([cartId, productoId]) // evita duplicar el mismo producto en el carrito
}
