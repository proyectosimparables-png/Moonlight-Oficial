generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String      @id @default(uuid())
  email                     String      @unique
  name                      String?
  password                  String
  isVerified                Boolean     @default(false)
  verificationCode          String?
  verificationCodeExpires   DateTime?
  role                      Role        @default(CLIENTE)
  image                     String?
  address                   String?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  carrito                   Cart?
  comentarios               Comentario[]
  favoritos                 Favorito[]
  ordenes                   Orden[]
}

model Producto {
  id                String            @id @default(uuid())
  nombre            String
  slug              String?  @unique
  descripcion       String?
  precio            Float
  precioPromocional Float?
  stock             Int

  // Envíos - peso y dimensiones
  peso              Float?     
  profundidad       Int?       
  ancho             Int?       
  alto              Int?       
  imagenUrl         String?
  createdAt         DateTime          @default(now())
  published         Boolean           @default(false)
  categoriaId       String?
  colores           String[]
  cortes            String[]
  talles            String[]
  cartItems         CartItem[]
  favoritos         Favorito[]
  imagenes          Imagen[]
  categoria         Categoria?        @relation(fields: [categoriaId], references: [id])
  secciones         ProductoSeccion[]
}

model Imagen {
  id         String   @id @default(uuid())
  url        String
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Categoria {
  id            String      @id @default(uuid())
  nombre        String
  seccionId     String?
  parentId      String?
  slug          String?
  parent        Categoria?  @relation("Subcategorias", fields: [parentId], references: [id])
  subcategorias Categoria[] @relation("Subcategorias")
  seccion       Seccion?    @relation(fields: [seccionId], references: [id])
  productos     Producto[]
}

model ProductoSeccion {
  productoId String
  seccionId  String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  seccion    Seccion  @relation(fields: [seccionId], references: [id], onDelete: Cascade)

  @@id([productoId, seccionId])
}

model Seccion {
  id         String            @id @default(uuid())
  nombre     String
  slug       String?           @unique
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  categorias Categoria[]
  productos  ProductoSeccion[]
}

model Comentario {
  id        String   @id @default(uuid())
  contenido String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Orden {
  id                      String      @id @default(uuid())
  userId                  String
  total                   Float
  estado                  EstadoOrden @default(PENDIENTE)
  metodoPago              MetodoPago  @default(MERCADO_PAGO) // <--- Agregado para distinguir medios de pago
  carritoAbandonadoEmail  Boolean     @default(false)
  carritoCreadoEn         DateTime    @default(now())
  
  // Datos del Destinatario (Capturas 2 y 3)
  emailContacto           String?     // Email ingresado en checkout
  nombreDestinatario      String?
  apellidoDestinatario    String?
  dniDestinatario         String?
  telefonoDestinatario    String?

  // Datos de Envío (Captura 1 y 2)
  metodoEnvio             String?     // Correo Argentino, Retiro, etc.
  costoEnvio              Float       @default(0)
  codigoPostal            String?
  provincia               String?
  localidad               String?
  calle                   String?
  numero                  String?
  piso                    String?
  departamento            String?
  notasEntrega            String?     // Aclaraciones y comentarios

  // Referencias de Pago
  paymentId               String?
  preferenceId            String?
  merchantOrderId         String?
  
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  user                    User        @relation(fields: [userId], references: [id])
  items                   OrdenItem[]

  @@index([userId])
}

model OrdenItem {
  id         String  @id @default(uuid())
  ordenId    String
  nombre     String
  precio     Float
  cantidad   Int
  productoId String?
  imagenUrl  String?
  orden      Orden   @relation(fields: [ordenId], references: [id])
}


model Favorito {
  id         String   @id @default(uuid())
  userId     String
  productoId String
  createdAt  DateTime @default(now())
  producto   Producto @relation(fields: [productoId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, productoId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  productoId String
  quantity   Int      @default(1)
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([cartId, productoId])
}

model PuntoEntrega {
  id             String   @id @default(uuid())
  nombre         String
  direccion      String
  localidad      String
  disponibilidad String
  costo          Float    @default(0)
  esDomicilio    Boolean  @default(false)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

enum EstadoOrden {
  CARRITO
  PENDIENTE
  PAGADO
  EMPAQUETADO
  ENVIADO
  ENTREGADO
  REEMBOLSADO
  CANCELADO
}

enum MetodoPago {
  MERCADO_PAGO
  TRANSFERENCIA
  EFECTIVO
}

enum Role {
  ADMIN
  CLIENTE
}