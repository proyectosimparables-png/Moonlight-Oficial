datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/* -----------------------------
   USUARIOS & AUTENTICACIÓN
------------------------------ */

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  name       String?
  password   String
  isVerified             Boolean     @default(false)
  verificationCode       String?
  verificationCodeExpires DateTime?
  role       Role        @default(CLIENTE)
  image      String?
  address    String?
  carrito    Cart?
  comentarios Comentario[]
  favoritos   Favorito[]
  historial   Historial[]
  ordenes     Orden[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

/* -----------------------------
   PRODUCTOS & CATEGORÍA
------------------------------ */

model Producto {
  id                String     @id @default(uuid())
  nombre            String
  descripcion       String?
  precio            Float
  precioPromocional Float?     
  stock             Int

  // Envíos - peso y dimensiones
  peso              Float?     
  profundidad       Int?       
  ancho             Int?       
  alto              Int?       

  imagenUrl         String?
  createdAt         DateTime   @default(now())
  published         Boolean    @default(false)
  categoriaId       String?

  cartItems         CartItem[]
  favoritos         Favorito[]
  imagenes          Imagen[]

  categoria         Categoria? @relation(fields: [categoriaId], references: [id])
  secciones         ProductoSeccion[]
}

model Imagen {
  id         String   @id @default(uuid())
  url        String
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Categoria {
  id            String      @id @default(uuid())
  nombre        String
  seccionId     String?
  parentId      String?
  slug          String?
  parent        Categoria?  @relation("Subcategorias", fields: [parentId], references: [id])
  subcategorias Categoria[] @relation("Subcategorias")
  seccion       Seccion?    @relation(fields: [seccionId], references: [id])
  productos     Producto[]
}

model ProductoSeccion {
  productoId String
  seccionId  String

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  seccion  Seccion  @relation(fields: [seccionId], references: [id], onDelete: Cascade)

  @@id([productoId, seccionId])
}

model Seccion {
  id         String      @id @default(uuid())
  nombre     String
  slug       String?     @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  categorias Categoria[]
  productos  ProductoSeccion[]
}

/* -----------------------------
   COMENTARIOS
------------------------------ */

model Comentario {
  id        String   @id @default(uuid())
  contenido String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}


// Definimos los estados posibles según la captura
enum EstadoOrden {
  CARRITO
  PENDIENTE
  PAGADO
  EMPAQUETADO
  ENVIADO
  ENTREGADO
  REEMBOLSADO
  CANCELADO
}


/* -----------------------------
   ÓRDENES
------------------------------ */


model Orden {
  id                     String      @id @default(uuid())
  userId                 String
  total                  Float
  estado                 EstadoOrden @default(PENDIENTE)

  carritoAbandonadoEmail Boolean     @default(false)
  carritoCreadoEn        DateTime    @default(now())

  paymentId              String?
  merchantOrderId        String?

  metodoEnvio            String?
  costoEnvio             Float       @default(0)
  direccionEnvio         String?

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  user                   User        @relation(fields: [userId], references: [id])
  items                  OrdenItem[]

  @@index([userId])
}


model OrdenItem {
  id         String   @id @default(uuid())
  ordenId    String
  nombre     String
  precio     Float
  cantidad   Int
  productoId String?
  imagenUrl  String?
  orden      Orden    @relation(fields: [ordenId], references: [id])
}

/* -----------------------------
   HISTORIAL
------------------------------ */

model Historial {
  id         String   @id @default(uuid())
  userId     String
  productoId String?
  accion     String
  fecha      DateTime @default(now())
  imagenUrl  String?
  nombre     String?
  precio     Float?
  user       User     @relation(fields: [userId], references: [id])
}

/* -----------------------------
   FAVORITOS
------------------------------ */

model Favorito {
  id         String   @id @default(uuid())
  userId     String
  productoId String
  createdAt  DateTime @default(now())
  producto   Producto @relation(fields: [productoId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, productoId])
}

/* -----------------------------
   CARRITO
------------------------------ */

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  productoId String
  quantity   Int      @default(1)
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([cartId, productoId])
}

model PuntoEntrega {
  id             String   @id @default(uuid())
  nombre         String   // Ej: "Showroom Caballito" o "Mi Domicilio"
  direccion      String
  localidad      String
  disponibilidad String   // Ej: "Lunes a Viernes 10 a 18hs"
  costo          Float    @default(0) // 0 sería gratis (retiro)
  esDomicilio    Boolean  @default(false) // Para diferenciar el punto principal
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
}




enum Role {
  ADMIN
  CLIENTE
}
