generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String      @id @default(uuid())
  email                     String      @unique
  name                      String?
  password                  String
  isVerified                Boolean     @default(false)
  verificationCode          String?
  verificationCodeExpires   DateTime?
  role                      Role        @default(CLIENTE)
  image                     String?
  address                   String?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  carrito                   Cart?
  comentarios               Comentario[]
  favoritos                 Favorito[]
  ordenes                   Orden[]
}

model Producto {
  id                String            @id @default(uuid())
  nombre            String
  slug              String?  @unique
  descripcion       String?
  precio            Float
  precioPromocional Float?
  stock             Int

  // Envíos - peso y dimensiones
  peso              Int               // Peso en GRAMOS (Ej: 500)
  profundidad       Int               // Profundidad en CM (largo)
  ancho             Int               // Ancho en CM
  alto              Int               // Alto en CM    
  imagenUrl         String?
  createdAt         DateTime          @default(now())
  published         Boolean           @default(false)
  categoriaId       String?
  colores           String[]
  cortes            String[]
  talles            String[]
  cartItems         CartItem[]
  favoritos         Favorito[]
  imagenes          Imagen[]
  categoria         Categoria?        @relation(fields: [categoriaId], references: [id])
  secciones         ProductoSeccion[]

// NUEVO CAMPO PARA LAS PROMOS
  promociones       Promocion[]       @relation("ProductoPromocion")
}

model Imagen {
  id         String   @id @default(uuid())
  url        String
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Categoria {
  id            String      @id @default(uuid())
  nombre        String
  seccionId     String?
  parentId      String?
  slug          String?
  parent        Categoria?  @relation("Subcategorias", fields: [parentId], references: [id])
  subcategorias Categoria[] @relation("Subcategorias")
  seccion       Seccion?    @relation(fields: [seccionId], references: [id])
  productos     Producto[]

  // NUEVA RELACIÓN: Una categoría puede tener muchas promociones aplicadas
  promociones   Promocion[] @relation("CategoriaPromocion")
}

model ProductoSeccion {
  productoId String
  seccionId  String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  seccion    Seccion  @relation(fields: [seccionId], references: [id], onDelete: Cascade)

  @@id([productoId, seccionId])
}

model Seccion {
  id         String            @id @default(uuid())
  nombre     String
  slug       String?           @unique
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  categorias Categoria[]
  productos  ProductoSeccion[]

  // NUEVA RELACIÓN
  promociones Promocion[]       @relation("SeccionPromocion")
}

model Comentario {
  id        String   @id @default(uuid())
  contenido String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Orden {
  id                      String      @id @default(uuid())
  userId                  String
  total                   Float
  estado                  EstadoOrden @default(PENDIENTE)
  metodoPago              MetodoPago  @default(MERCADO_PAGO) // <--- Agregado para distinguir medios de pago
  carritoAbandonadoEmail  Boolean     @default(false)
  carritoCreadoEn         DateTime    @default(now())
  
  // Datos del Destinatario (Capturas 2 y 3)
  emailContacto           String?     // Email ingresado en checkout
  nombreDestinatario      String?
  apellidoDestinatario    String?
  dniDestinatario         String?
  telefonoDestinatario    String?

  // Datos de Envío (Captura 1 y 2)
  metodoEnvio             String?     // Correo Argentino, Retiro, etc.
  costoEnvio              Float       @default(0)
  codigoPostal            String?
  provincia               String?
  localidad               String?
  calle                   String?
  numero                  String?
  piso                    String?
  departamento            String?
  notasEntrega            String?     // Aclaraciones y comentarios

  // Datos técnicos Correo
  productType             String?   // CP o EP
  deliveredType           String?   // S o D
  trackingCode            String?
  shipmentId              String?

  // Referencias de Pago
  paymentId               String?
  preferenceId            String?
  merchantOrderId         String?
  
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  user                    User        @relation(fields: [userId], references: [id])
  items                   OrdenItem[]

  @@index([userId])
}

model OrdenItem {
  id         String  @id @default(uuid())
  ordenId    String
  nombre     String
  precio     Float // El precio original del producto
  precioFinal    Float?   // El precio que pagó (con promo aplicada)
  descuentoTotal Float   @default(0) // Cuánta plata se ahorró en este item
  cantidad   Int
  peso       Int?    // Peso unitario al momento de la compra
  productoId String?
  imagenUrl  String?
  orden      Orden   @relation(fields: [ordenId], references: [id])
}


model Favorito {
  id         String   @id @default(uuid())
  userId     String
  productoId String
  createdAt  DateTime @default(now())
  producto   Producto @relation(fields: [productoId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, productoId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  productoId String
  quantity   Int      @default(1)
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([cartId, productoId])
}

model PuntoEntrega {
  id             String   @id @default(uuid())
  nombre         String
  direccion      String
  localidad      String
  disponibilidad String
  costo          Float    @default(0)
  esDomicilio    Boolean  @default(false)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

// 1. Enum para los tipos de promoción
enum TipoPromocion {
  PORCENTAJE          // Descuento directo (ej: -20% en el producto o categoría)
  CANTIDAD_X_CANTIDAD // 2x1, 3x2, 4x3, etc.
  SEGUNDA_UNIDAD      // Descuento en la unidad par (ej: 50% en la 2da unidad)
}

// 2. Modelo de Promoción Actualizado
model Promocion {
  id                String        @id @default(uuid())
  nombre            String        // Ej: "Promo Lanzamiento", "3x2 en Invierno"
  tipo              TipoPromocion
  
  // --- CONFIGURACIÓN DE LÓGICA ---
  // false = El 2x1/3x2 se aplica solo si llevas el MISMO producto.
  // true  = El 2x1/3x2 permite mezclar productos de la misma promo/categoría.
  esCombinable      Boolean       @default(false) 

  // Para PORCENTAJE (ej: 20) o SEGUNDA_UNIDAD (ej: 50 para el 50% off)
  valor             Float?        
  
  // Para CANTIDAD_X_CANTIDAD (ej: lleva 3 paga 2)
  lleva             Int?          @default(1)
  paga              Int?          @default(1)

  // --- CONTROL Y PRIORIDAD ---
  prioridad         Int           @default(0)     // Mayor número = se aplica primero
  acumulable        Boolean       @default(false) // ¿Se suma a otras promos activas?
  descripcion       String?       
  activa            Boolean       @default(true)
  fechaInicio       DateTime?
  fechaFin          DateTime?
  
  // --- RELACIONES ---
  // Relación con productos individuales
  productos         Producto[]    @relation("ProductoPromocion")
  
  // Relación con categorías (Aplica la promo a todos los productos de la categoría)
  categorias        Categoria[]   @relation("CategoriaPromocion")

  // NUEVA RELACIÓN
  secciones     Seccion[]       @relation("SeccionPromocion")
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum EstadoOrden {
  CARRITO
  PENDIENTE
  PAGADO
  EMPAQUETADO
  ENVIADO
  ENTREGADO
  REEMBOLSADO
  CANCELADO
}

enum MetodoPago {
  MERCADO_PAGO
  TRANSFERENCIA
  EFECTIVO
  GO_CUOTAS
}

enum Role {
  ADMIN
  CLIENTE
}