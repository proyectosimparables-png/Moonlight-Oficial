generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String       @id
  email       String       @unique
  name        String?
  password    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  role        Role         @default(CLIENTE)
  image       String?
  cart        Cart?
  comentarios Comentario[]
  favoritos   Favorito[]
  historial   Historial[]
  ordenes     Orden[]
}

model Producto {
  id          String       @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Float
  stock       Int
  imagenUrl   String?
  createdAt   DateTime     @default(now())
  published   Boolean      @default(false)
  imagenes    Imagen[]

  favoritos   Favorito[]
  cartItems   CartItem[]

  categoriaId String?
  categoria   Categoria?   @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  seccionId   String?
  seccion     Seccion?     @relation(fields: [seccionId], references: [id], onDelete: SetNull)

  comentarios Comentario[]
  historial   Historial[]
  ordenes     Orden[]
}

model Imagen {
  id         String   @id @default(uuid())
  url        String
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Categoria {
  id            String      @id @default(uuid())
  nombre        String
  padreId       String?
  seccionId     String?
  padre         Categoria?  @relation("CategoriaPadre", fields: [padreId], references: [id])
  subcategorias Categoria[] @relation("CategoriaPadre")
  seccion       Seccion?    @relation(fields: [seccionId], references: [id])
  productos     Producto[]
}

model Seccion {
  id         String       @id @default(uuid())
  nombre     String
  slug       String?      @unique
  productos  Producto[]
  categorias Categoria[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime?    @updatedAt
}

model Comentario {
  id         String   @id @default(uuid())
  contenido  String
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])
}

model Orden {
  id             String      @id @default(uuid())
  userId         String
  estado         String
  total          Float
  correoEnviado  Boolean     @default(false)
  createdAt      DateTime    @default(now())

  user           User        @relation(fields: [userId], references: [id])
  items          OrdenItem[]

  @@index([userId])
}

model OrdenItem {
  id          String   @id @default(uuid())
  ordenId     String
  nombre      String
  precio      Float
  cantidad    Int
  productoId  String?
  imagenUrl   String?

  orden       Orden     @relation(fields: [ordenId], references: [id])
}

model Historial {
  id         String   @id @default(uuid())
  userId     String
  accion     String
  fecha      DateTime @default(now())

  productoId String?
  nombre     String?
  precio     Float?
  imagenUrl  String?

  user       User     @relation(fields: [userId], references: [id])
}

model Favorito {
  id         String   @id @default(uuid())
  userId     String
  productoId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([userId, productoId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id          String   @id @default(uuid())
  cartId      String
  productoId  String
  quantity    Int      @default(1)

  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  producto    Producto @relation(fields: [productoId], references: [id])

  @@unique([cartId, productoId])
}

enum Role {
  ADMIN
  CLIENTE
}
