datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model User {
  id        String   @id // viene de Supabase Auth
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(CLIENTE)
  image     String? 
  address   String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  comentarios Comentario[]
  favoritos   Favorito[]
  historial   Historial[]
  ordenes     Orden[]

  // 🔥 Relación faltante (corregido)
  carrito     Cart?
}

model Producto {
  id          String     @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Float
  stock       Int
  imagenUrl   String?
  createdAt   DateTime   @default(now())
  categoriaId String?
  published   Boolean    @default(false)
  seccionId   String?
  cartItems   CartItem[]
  favoritos   Favorito[]
  imagenes    Imagen[]
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
  seccion     Seccion?   @relation(fields: [seccionId], references: [id])
}

model Imagen {
  id         String   @id @default(uuid())
  url        String
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Categoria {
  id            String      @id @default(uuid())
  nombre        String
  padreId       String?
  seccionId     String?
  padre         Categoria?  @relation("CategoriaPadre", fields: [padreId], references: [id])
  subcategorias Categoria[] @relation("CategoriaPadre")
  seccion       Seccion?    @relation(fields: [seccionId], references: [id])
  productos     Producto[]
}

model Seccion {
  id         String      @id @default(uuid())
  nombre     String
  createdAt  DateTime    @default(now())
  slug       String?     @unique
  updatedAt  DateTime?   @updatedAt
  categorias Categoria[]
  productos  Producto[]
}

model Comentario {
  id        String   @id @default(uuid())
  contenido String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Orden {
  id            String      @id @default(uuid())
  userId        String
  total         Float
  estado        String
  createdAt     DateTime    @default(now())
  correoEnviado Boolean     @default(false)
  user          User        @relation(fields: [userId], references: [id])
  items         OrdenItem[]

  @@index([userId])
}

model OrdenItem {
  id         String  @id @default(uuid())
  ordenId    String
  nombre     String
  precio     Float
  cantidad   Int
  productoId String?
  imagenUrl  String?
  orden      Orden   @relation(fields: [ordenId], references: [id])
}

model Historial {
  id         String   @id @default(uuid())
  userId     String
  productoId String?
  accion     String
  fecha      DateTime @default(now())
  imagenUrl  String?
  nombre     String?
  precio     Float?
  user       User     @relation(fields: [userId], references: [id])
}

model Favorito {
  id         String   @id @default(uuid())
  userId     String
  productoId String
  createdAt  DateTime @default(now())
  producto   Producto @relation(fields: [productoId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, productoId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  productoId String
  quantity   Int      @default(1)
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([cartId, productoId])
}

enum Role {
  ADMIN
  CLIENTE
}
